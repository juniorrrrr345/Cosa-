# Token du bot Telegram (obtenu via @BotFather)
BOT_TOKEN=your_bot_token_here

# ID Telegram de l'administrateur principal
ADMIN_ID=your_telegram_id_here

# URI de connexion MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/telegram_bot?retryWrites=true&w=majority

# Port pour le serveur web (optionnel pour Render)
PORT=3000

# URL du webhook (pour déploiement sur Render)
WEBHOOK_URL=https://your-app.onrender.com

# Environnement (development ou production)
NODE_ENV=production